#!/bin/sh
set -eu

if [ -n "${ITERIS_BIN:-}" ]; then
    exec "$ITERIS_BIN" "$@"
fi
if command -v iteris >/dev/null 2>&1; then
    exec iteris "$@"
fi
project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
iteris_local="$project_root/../../tools/iteris/.venv/bin/iteris"
if [ -x "$iteris_local" ]; then
    exec "$iteris_local" "$@"
fi
printf '%s\n' 'Iteris is not installed. Install official Iteris or set ITERIS_BIN to its absolute executable path.' >&2
exit 127
